# Copy to .env.local for local dev, or set these in Vercel project settings.
# All VITE_* vars are bundled into the client JS at build time — they are
# visible in browser devtools. Use a server-rendered template for real secrets.

VITE_BINDER_GATEWAY_URL=wss://localhost:18789/
VITE_BINDER_AUTH_TOKEN=
VITE_BINDER_USER_ID=
